#!/bin/sh /etc/rc.common
# Front-panel status LED daemon for the Linksys MBE7000 (blue/white/red).

START=99
USE_PROCD=1

start_service() {
	# board-guard: no-op on other qualcommbe/ipq95xx devices
	case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in linksys,mbe70|linksys,mbe7000) ;; *) return 0 ;; esac

	procd_open_instance
	procd_set_param command /usr/sbin/mbe7000-ledd
	procd_set_param respawn
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}
