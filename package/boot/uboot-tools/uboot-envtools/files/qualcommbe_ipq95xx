[ -e /etc/config/ubootenv ] && exit 0

touch /etc/config/ubootenv

. /lib/uboot-envtools.sh
. /lib/functions.sh

board=$(board_name)

case "$board" in
8devices,kiwi-dvk)
	ubootenv_add_mmc "0:APPSBLENV" "" "0x0" "0x40000" "0x40000"
	;;
linksys,mbe70|linksys,mbe7000)
	# U-Boot text env lives in the 'u_env' eMMC partition, offset 0, 256 KiB,
	# single copy - identical to the stock firmware's /etc/fw_env.config
	# (/dev/mmcblk0p21 0x0 0x40000). Holds boot_part / auto_recovery /
	# boot_part_ready / bootcmd. (The dual-boot boot counter is a separate
	# binary in 's_env', reset by the bootcount init script - not via fw_setenv.)
	ubootenv_add_mmc "u_env" "" "0x0" "0x40000"
	;;
esac

config_load ubootenv
config_foreach ubootenv_add_app_config

exit 0
