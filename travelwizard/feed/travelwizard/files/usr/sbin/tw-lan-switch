#!/bin/sh
# Move the GL-MT3000's physical LAN jack between the direct and protected
# bridges. The network UCI change is persistent; the link bounce makes the
# attached client notice that it must obtain an address from the other subnet.

PORT=${TW_LAN_PORT:-$(uci -q get travelwizard.main.lan_port 2>/dev/null)}
PORT=${PORT:-eth1}
LOCK=/var/lock/tw-lan-switch.lock

json_error() {
	printf '{"error":"%s"}\n' "$1"
}

case "$PORT" in
	''|*[!A-Za-z0-9_.:-]*)
		json_error "invalid LAN port"
		exit 1
		;;
esac

# Print the UCI section for a named device. Device sections generated by
# OpenWrt are normally anonymous (@device[N]), while ours may be named later;
# walking their declared types handles both forms without relying on indexes.
device_section() { # bridge-name
	local section
	for section in $(uci show network 2>/dev/null \
		| sed -n 's/^network\.\([^.=]*\)=device$/\1/p'); do
		if [ "$(uci -q get "network.$section.name" 2>/dev/null)" = "$1" ]; then
			printf '%s\n' "$section"
			return 0
		fi
	done
	return 1
}

has_port() { # device-section port
	local member
	for member in $(uci -q get "network.$1.ports" 2>/dev/null); do
		[ "$member" = "$2" ] && return 0
	done
	return 1
}

current_network() { # lan-section vault-section
	local in_lan=0 in_vault=0
	has_port "$1" "$PORT" && in_lan=1
	has_port "$2" "$PORT" && in_vault=1
	if [ "$in_lan" = 1 ] && [ "$in_vault" = 0 ]; then
		printf 'lan\n'
	elif [ "$in_lan" = 0 ] && [ "$in_vault" = 1 ]; then
		printf 'vault\n'
	elif [ "$in_lan" = 1 ]; then
		printf 'conflict\n'
	else
		printf 'none\n'
	fi
}

status_json() { # network [changed]
	local network="$1" changed="${2:-false}" mode
	case "$network" in
		lan) mode=direct ;;
		vault) mode=protected ;;
		*) mode=unknown ;;
	esac
	printf '{"ok":true,"changed":%s,"mode":"%s","network":"%s","port":"%s"}\n' \
		"$changed" "$mode" "$network" "$PORT"
}

LAN_BRIDGE=$(uci -q get network.lan.device 2>/dev/null)
VAULT_BRIDGE=$(uci -q get network.vault.device 2>/dev/null)
LAN_SECTION=$(device_section "$LAN_BRIDGE")
VAULT_SECTION=$(device_section "$VAULT_BRIDGE")

if [ -z "$LAN_BRIDGE" ] || [ -z "$LAN_SECTION" ]; then
	json_error "direct LAN bridge not found"
	exit 1
fi
if [ -z "$VAULT_BRIDGE" ] || [ -z "$VAULT_SECTION" ]; then
	json_error "protected LAN bridge not found"
	exit 1
fi

case "${1:-status}" in
	status)
		status_json "$(current_network "$LAN_SECTION" "$VAULT_SECTION")"
		exit 0
		;;
	direct|lan|setup)
		TARGET_NETWORK=lan
		TARGET_SECTION=$LAN_SECTION
		;;
	protected|vault|vpn)
		TARGET_NETWORK=vault
		TARGET_SECTION=$VAULT_SECTION
		;;
	*)
		json_error "usage: tw-lan-switch [status|direct|protected]"
		exit 1
		;;
esac

if ! lock "$LOCK" 2>/dev/null; then
	json_error "LAN switch is busy"
	exit 1
fi
unlock() { lock -u "$LOCK" >/dev/null 2>&1 || :; }
trap unlock EXIT INT TERM

# Re-read after taking the lock: a physical switch event may have raced us.
OLD_NETWORK=$(current_network "$LAN_SECTION" "$VAULT_SECTION")
if [ "$OLD_NETWORK" = "$TARGET_NETWORK" ]; then
	status_json "$TARGET_NETWORK"
	exit 0
fi

uci -q del_list "network.$LAN_SECTION.ports=$PORT" >/dev/null 2>&1 || :
uci -q del_list "network.$VAULT_SECTION.ports=$PORT" >/dev/null 2>&1 || :
if ! uci add_list "network.$TARGET_SECTION.ports=$PORT" >/dev/null 2>&1; then
	# Put the pending UCI state back as it was without reverting unrelated
	# network edits another administrator may have staged.
	case "$OLD_NETWORK" in
		lan) uci -q add_list "network.$LAN_SECTION.ports=$PORT" >/dev/null 2>&1 ;;
		vault) uci -q add_list "network.$VAULT_SECTION.ports=$PORT" >/dev/null 2>&1 ;;
		conflict)
			uci -q add_list "network.$LAN_SECTION.ports=$PORT" >/dev/null 2>&1
			uci -q add_list "network.$VAULT_SECTION.ports=$PORT" >/dev/null 2>&1
			;;
	esac
	json_error "could not update LAN bridge"
	exit 1
fi
if ! uci commit network >/dev/null 2>&1; then
	json_error "could not save LAN bridge"
	exit 1
fi

# Dropping carrier prompts the wired client to discard its old lease. netifd
# then attaches the port to the newly selected bridge during the reload.
# The dwell gives the client time to notice the outage before we return.
ip link set dev "$PORT" down >/dev/null 2>&1 || :
sleep 1
if ! ubus call network reload >/dev/null 2>&1; then
	ip link set dev "$PORT" up >/dev/null 2>&1 || :
	json_error "LAN bridge saved but network reload failed"
	exit 1
fi
ip link set dev "$PORT" up >/dev/null 2>&1 || :

[ "$TARGET_NETWORK" = vault ] && MODE_LABEL=protected || MODE_LABEL=direct
logger -t travelwizard "LAN port $PORT switched to $TARGET_NETWORK ($MODE_LABEL)"
status_json "$TARGET_NETWORK" true
