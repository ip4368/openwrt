#!/bin/sh
# Apply the VPN/proxy mode from /etc/config/travelwizard: rewrite the
# per-mode network/service config, point policy routing (pbr) at the tunnel
# for the vault subnet only, and restart services. Prints JSON.
# Usage: tw-vpn-apply
# TW_JSHN/TW_COMMON/TW_SB_LIVE/TW_INIT_DIR/TW_IFUP override the stock paths
# for tests.
. "${TW_JSHN:-/usr/share/libubox/jshn.sh}"
. "${TW_COMMON:-/usr/lib/travelwizard/common.sh}"

INIT_DIR="${TW_INIT_DIR:-/etc/init.d}"
IFUP="${TW_IFUP:-/sbin/ifup}"

MODE=$(tw_active_mode)
# Resolve the settings section: active profile, or the legacy per-mode section.
SRC=$(uci -q get travelwizard.main.active_profile)
if [ -z "$SRC" ] || [ -z "$(uci -q get travelwizard.$SRC.type 2>/dev/null)" ]; then
	case "$MODE" in
		wireguard) SRC="wg" ;;
		openvpn) SRC="ovpn" ;;
		singbox) SRC="sb" ;;
		*) SRC="" ;;
	esac
fi
VAULT_IP=$(uci -q get network.vault.ipaddr); VAULT_IP=${VAULT_IP:-10.20.30.1}
VAULT_NET="${VAULT_IP%.*}.0/24"
SB_CONF=""; OVPN_CONF=""
if [ -n "$SRC" ]; then
	SB_CONF=$(uci -q get "travelwizard.$SRC.config_file" 2>/dev/null)
	OVPN_CONF="$SB_CONF"
fi
SB_CONF="${SB_CONF:-/etc/sing-box/config.json}"
OVPN_CONF="${OVPN_CONF:-/etc/openvpn/tw.conf}"

fail() { echo "{\"error\":\"$1\"}"; exit 1; }
wait_device() { # $1 device $2 seconds
	local n=0
	while ! ip link show "$1" >/dev/null 2>&1 && [ "$n" -lt "$2" ]; do
		sleep 1; n=$((n + 1))
	done
	ip link show "$1" >/dev/null 2>&1
}
wait_interface() { # $1 netifd interface $2 seconds (best effort)
	local n=0 up
	while [ "$n" -lt "$2" ]; do
		up=$(ubus call "network.interface.$1" status 2>/dev/null \
			| jsonfilter -e '@.up' 2>/dev/null)
		[ "$up" = "true" ] && return 0
		sleep 1; n=$((n + 1))
	done
	return 1
}

# --- stop everything first ----------------------------------------------
uci -q delete network.tw_wg
uci -q delete network.tw_wg_peer
uci set network.vpntun='interface'
uci set network.vpntun.proto='none'
uci set network.vpntun.auto='0'
# Scrub per-mode vpntun wiring (a singbox run leaves static tun0 address
# ownership behind, which must not linger into off/wireguard/openvpn).
uci -q delete network.vpntun.device
uci -q delete network.vpntun.ipaddr
uci -q delete network.vpntun.netmask
uci -q delete openvpn.tw
uci set openvpn.tw='openvpn'
uci set openvpn.tw.enabled='0'
uci set openvpn.tw.config="$OVPN_CONF"
uci commit network
uci commit openvpn
# NOTE: the init script spawns no instances unless sing-box.main.enabled=1,
# so init-disable alone does not stop it; park the uci flag too.
if [ -n "$(uci -q get sing-box.main.enabled 2>/dev/null)" ]; then
	uci set sing-box.main.enabled='0'
	uci commit sing-box
fi
"$INIT_DIR/sing-box" stop >/dev/null 2>&1
"$INIT_DIR/sing-box" disable >/dev/null 2>&1
"$INIT_DIR/openvpn" stop >/dev/null 2>&1

# --- per-mode setup ------------------------------------------------------
VPN_IF=""
VAULT_DNS=""
case "$MODE" in
	off) VPN_IF="" ;;
	wireguard)
		command -v wg >/dev/null 2>&1 || fail "wireguard-tools not installed"
		PRIV=$(uci -q get "travelwizard.$SRC.private_key")
		PUB=$(uci -q get "travelwizard.$SRC.peer_public_key")
		EP=$(uci -q get "travelwizard.$SRC.endpoint_host")
		[ -z "$PRIV" ] || [ -z "$PUB" ] || [ -z "$EP" ] \
			&& fail "incomplete WireGuard settings"
		uci set network.tw_wg='interface'
		uci set network.tw_wg.proto='wireguard'
		uci set network.tw_wg.private_key="$PRIV"
		uci -q delete network.tw_wg.addresses
		for a in $(uci -q get "travelwizard.$SRC.addresses"); do
			uci add_list network.tw_wg.addresses="$a"
		done
		# NOTE: the profile's DNS goes to vault clients (below), not to
		# network.tw_wg.dns: that would feed the router's own resolver,
		# whose queries bypass pbr and go out the direct upstream.
		VAULT_DNS=$(uci -q get "travelwizard.$SRC.dns")
		uci set network.tw_wg_peer='wireguard_tw_wg'
		uci set network.tw_wg_peer.public_key="$PUB"
		uci set network.tw_wg_peer.endpoint_host="$EP"
		uci set network.tw_wg_peer.endpoint_port="$(uci -q get "travelwizard.$SRC.endpoint_port")"
		uci -q delete network.tw_wg_peer.allowed_ips
		for a in $(uci -q get "travelwizard.$SRC.allowed_ips"); do
			uci add_list network.tw_wg_peer.allowed_ips="$a"
		done
		[ -n "$(uci -q get "travelwizard.$SRC.preshared_key")" ] && \
			uci set network.tw_wg_peer.preshared_key="$(uci -q get "travelwizard.$SRC.preshared_key")"
		uci set network.tw_wg_peer.persistent_keepalive='25'
		uci set network.tw_wg_peer.route_allowed_ips='0' # pbr routes instead
		VPN_IF="tw_wg"
		;;
	openvpn)
		command -v openvpn >/dev/null 2>&1 || fail "openvpn not installed"
		[ -s "$OVPN_CONF" ] || fail "no OpenVPN config uploaded"
		# Managed block: fixed tun name + no pulled routes (pbr routes).
		sed -i '/^# tw-managed$/,/^# \/tw-managed$/d' "$OVPN_CONF"
		{
			echo "# tw-managed"
			echo "dev tun_tw"
			echo "dev-type tun"
			echo "route-nopull"
			USER=$(uci -q get "travelwizard.$SRC.username")
			if [ -n "$USER" ]; then
				printf '%s\n%s\n' "$USER" "$(uci -q get "travelwizard.$SRC.password")" \
					> /etc/openvpn/tw.auth
				chmod 600 /etc/openvpn/tw.auth
				echo "auth-user-pass /etc/openvpn/tw.auth"
			fi
			echo "# /tw-managed"
		} >>"$OVPN_CONF"
		uci set openvpn.tw.enabled='1'
		uci set network.vpntun.device='tun_tw'
		uci set network.vpntun.auto='1'
		VPN_IF="vpntun"
		;;
	singbox)
		command -v sing-box >/dev/null 2>&1 || fail "sing-box not installed"
		[ -s "$SB_CONF" ] || fail "no proxy config imported yet"
		grep -q '"type"[[:space:]]*:[[:space:]]*"tun"' "$SB_CONF" \
			|| fail "profile config has no TUN inbound (re-import the subscription)"
		sing-box check -c "$SB_CONF" >/dev/null 2>&1 \
			|| fail "proxy config failed sing-box check"
		uci -q show sing-box.main >/dev/null 2>&1 \
			|| fail "sing-box service config missing"
		cp "$SB_CONF" "${TW_SB_LIVE:-/etc/sing-box/config.json}"
		chmod 600 "${TW_SB_LIVE:-/etc/sing-box/config.json}"
		# netifd owns the TUN address (must match the TUN inbound in
		# tw-sub-import): with proto=none a reconfigure flushes the
		# address sing-box assigned as foreign, masquerade falls back
		# to a LAN IP, and the vault stalls until the next connect.
		uci set network.vpntun.device='tun0'
		uci set network.vpntun.proto='static'
		uci set network.vpntun.ipaddr='172.19.0.1'
		uci set network.vpntun.netmask='255.255.255.252'
		uci set network.vpntun.auto='1'
		uci set sing-box.main.enabled='1'
		# TUN mode needs privilege (per the init script's own note).
		uci set sing-box.main.user='root'
		uci commit sing-box
		VPN_IF="vpntun"
		;;
	*) fail "unknown vpn mode: $MODE" ;;
esac

uci commit network
uci commit openvpn

# --- bring the tunnel up in netifd before pbr looks for it ----------------
# netifd must know the new vpntun definition before the tunnel starts, and
# pbr must only restart once the tunnel is up. The old order restarted pbr
# first: it found no vpntun and installed no route, so the first connect
# failed and a second one "fixed" it.
"$INIT_DIR/network" reload >/dev/null 2>&1
case "$MODE" in
	wireguard)
		"$IFUP" tw_wg >/dev/null 2>&1
		wait_interface tw_wg 5 || true
		;;
	openvpn)
		"$INIT_DIR/openvpn" restart >/dev/null 2>&1
		if wait_device tun_tw 10; then
			"$IFUP" vpntun >/dev/null 2>&1
			wait_interface vpntun 5 || true
		fi
		;;
	singbox)
		"$INIT_DIR/sing-box" enable >/dev/null 2>&1
		"$INIT_DIR/sing-box" restart >/dev/null 2>&1
		wait_device tun0 10 \
			|| fail "sing-box started but tun0 is missing (see logread for errors)"
		"$IFUP" vpntun >/dev/null 2>&1
		wait_interface vpntun 5 || true
		;;
esac

# --- vault DNS: public resolvers through the tunnel, never the router ------
[ -n "$(tw_dhcp_dns_option "$VAULT_DNS")" ] \
	|| VAULT_DNS=$(uci -q get travelwizard.main.vault_dns)
DNS_CHANGED=""
tw_set_vault_dns "$VAULT_DNS" && { uci commit dhcp; DNS_CHANGED=1; }

# Settle the firewall and DNS before pbr installs its rules, so a later
# firewall reload is never what makes routing work.
"$INIT_DIR/firewall" reload >/dev/null 2>&1
[ -n "$DNS_CHANGED" ] && "$INIT_DIR/dnsmasq" restart >/dev/null 2>&1

# --- policy routing: vault subnet -> VPN only -----------------------------
# pbr (policy-based routing) watches the tunnel and routes the vault SSID
# subnet through it. When the tunnel is down there is no route, and the
# firewall's vault->wan REJECT rule is the second layer: vault clients get
# VPN or nothing. The mgmt LAN is untouched (always direct).
if uci -q show pbr >/dev/null 2>&1; then
	# NOTE: keep the values unquoted: `uci set` stores argv literally,
	# so inner quotes become part of the value (and bool parsing breaks).
	SEC=""; DUPES=""
	for s in $(uci show pbr 2>/dev/null | sed -n 's/^pbr\.\([^.]*\)=policy/\1/p'); do
		pname=$(uci -q get pbr."$s".name)
		pname=${pname#"'"}
		pname=${pname%"'"}
		[ "$pname" = "vault-via-vpn" ] || continue
		# Prepend: delete highest index first, so lower indices don't shift.
		if [ -z "$SEC" ]; then SEC="$s"; else DUPES="$s $DUPES"; fi
	done
	for s in $DUPES; do uci -q delete pbr."$s"; done
	[ -z "$SEC" ] && SEC=$(uci add pbr policy)
	uci set pbr."$SEC".name="vault-via-vpn"
	uci set pbr."$SEC".src_addr="$VAULT_NET"
	if [ -n "$VPN_IF" ]; then
		uci set pbr."$SEC".interface="$VPN_IF"
		uci set pbr."$SEC".enabled="1"
	else
		uci set pbr."$SEC".enabled="0"
	fi
	uci set pbr.config.enabled="1"
	uci set pbr.config.strict_enforcement="1"
	# pbr sits in boot mode until its uplink is up; the travel upstream
	# roams between wan and wwan, so follow it (hotplug keeps it fresh).
	UP_IF=$(tw_upstream 2>/dev/null)
	[ -n "$UP_IF" ] && uci set pbr.config.uplink_interface="$UP_IF"
	uci commit pbr
	"$INIT_DIR/pbr" restart >/dev/null 2>&1
	PBR="true"
else
	PBR="false"
fi

json_init
json_add_string mode "$MODE"
[ -n "$SRC" ] && json_add_string profile "$(uci -q get "travelwizard.$SRC.name" 2>/dev/null)"
json_add_boolean applied 1
json_add_string vpn_interface "$VPN_IF"
json_add_string vault_net "$VAULT_NET"
json_add_string vault_dns "$(uci -q get dhcp.vault.dhcp_option)"
[ "$PBR" = "true" ] && json_add_boolean pbr 1 || json_add_boolean pbr 0
WARN=""
[ "$PBR" != "true" ] && WARN="pbr not installed: vault routing inactive until pbr is installed"
# Self-check: the tunnel device is up but no default route via it exists
# in any table, so the vault has no path even though the tunnel is fine
# (pbr policy inactive or still converging — retry a few times first).
TUNDEV=""
case "$MODE" in
	wireguard) TUNDEV="tw_wg" ;;
	openvpn) TUNDEV="tun_tw" ;;
	singbox) TUNDEV="tun0" ;;
esac
if [ -n "$TUNDEV" ] && ip link show "$TUNDEV" >/dev/null 2>&1; then
	n=0
	while ! tw_tunnel_routed "$TUNDEV" && [ "$n" -lt 4 ]; do
		sleep 2; n=$((n + 1))
	done
	tw_tunnel_routed "$TUNDEV" || \
		WARN="${WARN:+$WARN; }no route via $TUNDEV (vault has no path; check pbr)"
fi
# The reloads above can race sing-box's own TUN address assignment; a
# missing address breaks masquerade source selection and stalls the vault
# exactly like the old first-connect failure, so re-assert and verify.
if [ "$MODE" = "singbox" ] && ip link show tun0 >/dev/null 2>&1; then
	tw_tun_addr_ensure tun0 172.19.0.1/30 || \
		WARN="${WARN:+$WARN; }tun0 lost its IPv4 address (vault stalled; reconnect to repair)"
fi
# Same ownership problem for OpenVPN, but the address is server-pushed and
# only known after it connects: adopt whatever tun_tw currently has so
# later reloads re-assert it instead of flushing it as foreign. Best
# effort: if the link is not up yet the address is adopted on the next
# apply, and a server-side re-addressing likewise heals on reconnect.
if [ "$MODE" = "openvpn" ]; then
	n=0; OVPN_ADDR=""
	while [ -z "$OVPN_ADDR" ] && [ "$n" -lt 10 ]; do
		[ "$n" -gt 0 ] && sleep 1
		OVPN_ADDR=$(ip -o -4 addr show tun_tw scope global 2>/dev/null | awk '
			$4 ~ /\// { print $4; exit }
			$5 == "peer" { split($6, a, "/"); print $4"/"a[2]; exit }')
		n=$((n + 1))
	done
	if [ -n "$OVPN_ADDR" ]; then
		OVPN_MASK=$(plen2mask "${OVPN_ADDR#*/}")
		if [ -n "$OVPN_MASK" ]; then
			uci set network.vpntun.proto='static'
			uci set network.vpntun.ipaddr="${OVPN_ADDR%/*}"
			uci set network.vpntun.netmask="$OVPN_MASK"
			uci commit network
		fi
	else
		WARN="${WARN:+$WARN; }tun_tw has no address yet (reconnect once OpenVPN is connected)"
	fi
fi
[ -n "$WARN" ] && json_add_string warning "$WARN"
tw_kill_holding && json_add_boolean kill_holding 1 || json_add_boolean kill_holding 0
json_dump
