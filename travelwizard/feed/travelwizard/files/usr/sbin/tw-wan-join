#!/bin/sh
# Join an upstream Wi-Fi network as a wireless client (WISP/sta).
# Usage: tw-wan-join '<ssid>' '[key]' '[band]' '[enc-hint]' '[bssid]'
# band: 2g | 5g (places the sta iface on the matching radio).
# enc-hint: scan encryption string (picks the right WPA mode).
# Runs the subnet-conflict fix, lifts our setup portal, and returns as soon
# as the link is usable ("internet":null). Captive detection is left to the
# UI's own request: up to three eight-second probes here held the reply past
# uhttpd's 60 s script timeout, so a join that worked looked like it failed.
# TW_JSHN/TW_COMMON/TW_SUBNET_FIX/TW_PORTAL override the stock paths for tests.
. "${TW_JSHN:-/usr/share/libubox/jshn.sh}"
. "${TW_COMMON:-/usr/lib/travelwizard/common.sh}"

SUBNET_FIX="${TW_SUBNET_FIX:-/usr/sbin/tw-subnet-fix}"
PORTAL="${TW_PORTAL:-/usr/sbin/tw-portal}"

SSID="$1"
KEY="$2"
BAND="$3"
ENCHINT="$4"
BSSID="$5"
[ -z "$SSID" ] && { echo '{"error":"missing ssid"}'; exit 1; }
# Finish even if the web request goes away mid-join (the browser's device
# can drop off this router's Wi-Fi while the radio retunes).
trap '' HUP INT TERM PIPE

# Place the sta iface on the radio matching the target band. The APs on that
# radio follow the upstream channel; the other radio stays put.
pick_radio() {
	local r b
	for r in $(uci show wireless 2>/dev/null \
		| sed -n 's/^wireless\.\([^.]*\)=wifi-device/\1/p'); do
		b=$(uci -q get "wireless.$r.band")
		[ "$b" = "$1" ] && { echo "$r"; return 0; }
	done
	return 1
}
RADIO=""
[ -n "$BAND" ] && RADIO=$(pick_radio "$BAND")
[ -z "$RADIO" ] && RADIO=$(uci show wireless 2>/dev/null \
	| sed -n 's/^wireless\.\([^.]*\)=wifi-device/\1/p' | head -n 1)
[ -z "$RADIO" ] && { echo '{"error":"no wireless device found"}'; exit 1; }

uci -q delete wireless.wwan
uci set wireless.wwan='wifi-iface'
uci set wireless.wwan.device="$RADIO"
uci set wireless.wwan.mode='sta'
uci set wireless.wwan.network='wwan'
uci set wireless.wwan.ssid="$SSID"
if [ -z "$KEY" ]; then
	case "$ENCHINT" in
		""|none|NONE|unknown|UNKNOWN) ENC="none" ;;
		*) echo '{"error":"this network needs a password"}'; exit 1 ;;
	esac
	uci -q delete wireless.wwan.key
else
	ENC=$(tw_uci_encryption "$ENCHINT")
	[ "$ENC" = "eap" ] && { echo '{"error":"enterprise (802.1x) Wi-Fi is not supported"}'; exit 1; }
	[ "$ENC" = "none" ] && ENC="sae-mixed"
	uci set wireless.wwan.key="$KEY"
fi
uci set wireless.wwan.encryption="$ENC"
[ -n "$BSSID" ] && uci set wireless.wwan.bssid="$BSSID"
uci set wireless.wwan.disabled='0'
uci commit wireless
wifi reload "$RADIO" >/dev/null 2>&1

# Wait for the upstream link (association + DHCP).
LINKED="false"
i=0
while [ $i -lt 30 ]; do
	up=$(ubus call network.interface.wwan status 2>/dev/null \
		| jsonfilter -e '@.up' 2>/dev/null)
	[ "$up" = "true" ] && { LINKED="true"; break; }
	sleep 1
	i=$((i + 1))
done

if [ "$LINKED" != "true" ]; then
	echo '{"linked":false,"error":"could not connect (wrong password or out of range)"}'
	exit 1
fi

# Remember the network for one-tap reconnect (silent: JSON purity). The
# wwan hotplug records it at the same moment: the lock keeps the two from
# both adding an entry.
lock /var/lock/tw-saved
tw_saved_upsert "$SSID" "$KEY" "$BAND" "$ENCHINT" "$BSSID"
uci commit travelwizard
lock -u /var/lock/tw-saved

# Lift the setup portal now: hotplug normally does it on ifup, but a missed
# or early event would leave phones stuck behind the "sign in" hijack (DNS
# catch-all + port-80 redirect) even though the uplink works. Deriving the
# state again here is cheap and idempotent.
"$PORTAL" auto >/dev/null 2>&1

SUBNET_JSON=$("$SUBNET_FIX" 2>/dev/null)
[ -z "$SUBNET_JSON" ] && SUBNET_JSON='{"changed":false}'
# Once more after subnet-fix: it may restart the network (bouncing wwan),
# and a hotplug event lost in that window must not leave the portal up.
"$PORTAL" auto >/dev/null 2>&1

SSID_JSON=$(printf '%s' "$SSID" | sed 's/\\/\\\\/g; s/"/\\"/g; s/^/"/; s/$/"/')
printf '{"linked":true,"ssid":%s,"radio":"%s","subnet":%s,"internet":null}\n' \
	"$SSID_JSON" "$RADIO" "$SUBNET_JSON"
